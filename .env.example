# Copy to `.env` or `.env.local` next to package.json (both load; `.env.local` wins).

BOOKING_SCHEDULE_ID=
BOOKING_COOKIE=

# Optional
# POLL_MS=5000

# Auto-book (npm start) when TEAM in src/booking/team.ts is non-empty
# BOOKING_RECAPTCHA_TOKEN=

# npm run book — also BOOKING_START_UNIX, BOOKING_DURATION_MINUTES, same BOOKING_RECAPTCHA_TOKEN (or TEAM + optional BOOKING_AVAILABLE_SLOTS)
