# Copy to `.env` or `.env.local` in the project root (next to package.json). Both are loaded;
# `.env.local` overrides `.env`. Paths are resolved from the repo root, not your shell cwd.

BOOKING_SCHEDULE_ID=

# Optional overrides (defaults match Google Calendar ListAvailableSlots in a normal browser):
# BOOKING_URL=
# BOOKING_COOKIE=
# BOOKING_HEADERS_JSON=
# BOOKING_BODY_FILE=path/to/custom.request.body.json
# BOOKING_SLOTS_ARRAY_PATH=
# BOOKING_TZ=Europe/Stockholm
# POLL_MS=5000
#
# npm start: when src/booking/team.ts TEAM has members, new slots (vs first snapshot) auto-book up to min(new, |TEAM|).
# Set a fresh token before openings; the same string is sent for each BookSlot in one burst (may expire between calls).
# BOOKING_RECAPTCHA_TOKEN=
#
# One-shot BookSlot (npm run book): copy reCAPTCHA token from DevTools right before submit (same BOOKING_RECAPTCHA_TOKEN).
# With TEAM in booking/team.ts, npm run book picks one person: pool size = min(BOOKING_AVAILABLE_SLOTS, TEAM.length), then random from that pool. Defaults to 1 slot if unset.
# BOOKING_AVAILABLE_SLOTS=2
# BOOKING_EMAIL=
# BOOKING_FIRST=
# BOOKING_LAST=
# BOOKING_START_UNIX=1780322400
# BOOKING_DURATION_MINUTES=45
# BOOKING_APPOINTMENT_TITLE=   # optional; parsed from GetAppointmentServiceDefinition if omitted
# BOOKING_CONTEXT_ID=          # optional; parsed from definition if omitted
